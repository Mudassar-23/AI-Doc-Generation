# ---- Database ----
# PostgreSQL (production) — if connection fails, falls back to SQLite
DATABASE_URL=postgresql://aidocs:password@localhost:5432/aidocs
# SQLite fallback (auto-used if PostgreSQL is unavailable)
DATABASE_FALLBACK_URL=sqlite:///./data/aiNEWkkk.db

# ---- Abacus AI (uses Claude Sonnet via Abacus AI platform) ----
ABACUS_API_KEY=your-abacus-api-key-here
ABACUS_DEPLOYMENT_TOKEN=your-deployment-token-here
ABACUS_MODEL=claude-sonnet


# ---- Azure AI Foundry (any deployed model) ----
AZURE_AI_ENDPOINT=
AZURE_AI_API_KEY=
AZURE_AI_DEPLOYMENT_NAME=
#AZURE_AI_API_VERSION=2024-06-01


AZURE_EMBEDDING_ENDPOINT=
AZURE_EMBEDDING_DEPLOYMENT=

# ---- Azure DevOps (ADO) Credentials ----
ADO_PAT=
ADO_ORGANIZATION_URL=


# ---- Corporate Proxy / Custom SSL Certificate (Optional) ----

SSL_CERT_FILE=
REQUESTS_CA_BUNDLE=

# ---- Default AI Provider ----
# Options: abacus | azure_ai | mock
DEFAULT_AI_PROVIDER=mock

# ---- Runner Settings ----
RUNNER_POLL_INTERVAL=15 #15 seconds   # 4 minutes (240 seconds)
MAX_JOB_DURATION_MINUTES=300

# ---- Parallel LLM Analysis (Stage 4) ----
# Number of concurrent LLM API calls during chunk analysis.
LLM_PARALLEL_WORKERS=4

# ---- Chunking & Performance Tuning ----
# Smaller chunks = faster Azure responses (15-25s vs 90-120s per chunk)
# More chunks total, but each completes without timeouts.
TARGET_CHUNK_TOKENS=20000
MAX_CHUNK_TOKENS=25000
MAX_FILE_TOKENS=25000
TOKEN_CHAR_RATIO=4
LARGE_SOURCE_FILE_MAX_TOKENS=30000

# ---- Output ----
OUTPUT_DIR=./outputs
TEMP_DIR=./tmp

# ---- Security & CORS ----
ALLOWED_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000
RATE_LIMIT_PER_MINUTE=10

# ---- Server ----
HOST=0.0.0.0
PORT=8000

