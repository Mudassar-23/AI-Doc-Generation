# ============================================================
# AI Documentation Generation Platform — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.

# ---- Database ----
# PostgreSQL (production) — if connection fails, falls back to SQLite
DATABASE_URL=postgresql://aidocs:password@localhost:5432/aidocs
# SQLite fallback (auto-used if PostgreSQL is unavailable)
DATABASE_FALLBACK_URL=sqlite:///./data/aidocs.db

# ---- Abacus AI (uses Claude Sonnet via Abacus AI platform) ----
ABACUS_API_KEY=your-abacus-api-key-here
ABACUS_DEPLOYMENT_TOKEN=your-deployment-token-here
ABACUS_MODEL=claude-sonnet

# ---- Azure AI Foundry (any deployed model) ----
AZURE_AI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_AI_API_KEY=your-azure-api-key-here
AZURE_AI_DEPLOYMENT_NAME=your-model-deployment-name
AZURE_AI_API_VERSION=2024-06-01

# ---- Azure DevOps (ADO) Credentials ----
ADO_PAT=your-azure-devops-pat-here
ADO_ORGANIZATION_URL=https://dev.azure.com/your-organization

# ---- Azure OpenAI Embeddings (RAG — Stage 3.5) ----
AZURE_EMBEDDING_ENDPOINT=https://your-resource.openai.azure.com/openai/v1
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-ada-002

# ---- Corporate Proxy / Custom SSL Certificate (Optional) ----
# Path to custom CA certificate bundle (.pem) if running on a corporate network/proxy
# SSL_CERT_FILE=C:\Users\MHussain4\Downloads\nscacert.pem
# REQUESTS_CA_BUNDLE=C:\Users\MHussain4\Downloads\nscacert.pem

# ---- Default AI Provider ----
# Options: abacus | azure_ai | mock
DEFAULT_AI_PROVIDER=mock

# ---- Runner Settings ----
RUNNER_POLL_INTERVAL=2
MAX_JOB_DURATION_MINUTES=90

# ---- Chunking & Performance Settings ----
TARGET_CHUNK_TOKENS=6000
MAX_CHUNK_TOKENS=7000
LARGE_SOURCE_FILE_MAX_TOKENS=50000

# ---- Output ----
OUTPUT_DIR=./outputs
TEMP_DIR=./tmp

# ---- Security & CORS ----
ALLOWED_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000
RATE_LIMIT_PER_MINUTE=10

# ---- Server ----
HOST=0.0.0.0
PORT=8000

